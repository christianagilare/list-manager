# Base de datos
POSTGRES_DB=listmanager
POSTGRES_USER=listmanager
POSTGRES_PASSWORD=listmanager

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=list-uploads

# Backend (Spring Boot)
# SPRING_DATASOURCE_* se construyen en docker-compose a partir de POSTGRES_*
# Para desarrollo local (fuera de Docker) descomentar y ajustar:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/listmanager
# SPRING_DATASOURCE_USERNAME=listmanager
# SPRING_DATASOURCE_PASSWORD=listmanager
# MINIO_URL=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# Supabase Auth (obligatorio para proteger la API)
# Opción 1 - Legacy: JWT Secret en Dashboard → Project Settings → JWT Keys → pestaña "Legacy JWT Secret"
# SUPABASE_JWT_SECRET=your-jwt-secret
# Opción 2 - JWT Signing Keys (recomendado): URL JWKS. Reemplaza <project-ref> por el ref de tu proyecto Supabase.
# SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URI=https://dwikvmqvleflvfuurzbe.supabase.co/auth/v1/.well-known/jwks.json

# Frontend (Next.js)
# En Docker, NEXT_PUBLIC_API_URL debe ser la URL con la que el navegador accede al backend (ej. http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8085
NEXT_PUBLIC_SUPABASE_URL=https://dwikvmqvleflvfuurzbe.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImR3aWt2bXF2bGVmbHZmdXVyemJlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzIxMTI5OTIsImV4cCI6MjA4NzY4ODk5Mn0.XMltk5bdxyPb9YRBNE4YB7YySYuxOw69_grFQcc5D8k
